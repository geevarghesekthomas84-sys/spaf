# SPAF Configuration Environment Variables

# AI Configuration
AI_PROVIDER=google # google, claude, ollama, lmstudio
GOOGLE_API_KEY=your_google_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OLLAMA_URL=http://localhost:11434/v1
LM_STUDIO_URL=http://172.20.0.1:1234/v1
LOCAL_MODEL=  # Leave empty to auto-detect loaded model in LM Studio

# Provider model overrides (optional)
GOOGLE_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_MODEL=      # optional, auto-detected from the running server
LM_STUDIO_MODEL=   # optional, auto-detected from the loaded model

# Passive intelligence (optional)
SHODAN_API_KEY=    # enables passive Shodan enrichment in `spaf recon`
NIST_API_KEY=      # NVD API key — 10x faster CVE lookups in `spaf scan`

# Antigravity Cloud
ANTIGRAVITY_TOKEN=your_token_here

# Database backend: mongo (default) or sqlite (zero-setup offline fallback)
SPAF_DB_BACKEND=mongo

# MongoDB settings (used when SPAF_DB_BACKEND=mongo)
SPAF_MONGO_URI=mongodb://localhost:27017
SPAF_MONGO_DB=spaf

# SQLite settings (used when SPAF_DB_BACKEND=sqlite)
SPAF_SQLITE_PATH=spaf.db

# Logging configuration
SPAF_LOG_DIR=./logs

# Proxy & Stealth Configuration
USE_TOR=false
TOR_PROXY=socks5://127.0.0.1:9050
PROXY_FILE=  # Path to a file containing one proxy per line (http://ip:port)
RANDOM_USER_AGENT=true
SPAF_LOG_LEVEL=INFO

# ─── AI orchestration (optional) ─────────────────────────────────
# Route tasks to specific models (comma-separated = fallbacks). Unset = provider default.
SPAF_MODEL_PLAN=        # model(s) for agent planning
SPAF_MODEL_ANALYZE=     # model(s) for findings analysis
SPAF_MODEL_CODEGEN=     # model(s) for PoC / remediation code
SPAF_MODEL_DEFAULT=     # fallback model(s) for any task
SPAF_CACHE=on           # on|off — cache AI responses (logs/ai_cache.db)
SPAF_BUDGET_CALLS=16    # max AI calls per orchestrated run
SPAF_BUDGET_SECONDS=300 # max seconds per orchestrated run
